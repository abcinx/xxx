#!name=YouTube&YouTubeMusic
#!desc=去除广告，功能增强！
#!date=2026-07-19

[Argument]
blockUpload=switch, false, true, tag=隐藏(+), desc=隐藏YouTube底栏正中间的(+)
blockShorts=switch, false, true, tag=隐藏(Shorts), desc=隐藏YouTube底栏的(Shorts)
blockImmersive=switch, false, true, tag=隐藏(选段), desc=隐藏YouTube Music底栏的(选段)
captionLang=select, "zh-Hans", "zh-Hant", "ja", "ko", "en", "off", tag=字幕翻译语言, desc=需要把YouTube字幕翻译翻译为何种语言
debug=switch, false, true, tag=启用调试模式, desc=开启后将在日志中输出详细重写信息

[Script]
http-response ^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$ script-path=https://raw.githubusercontent.com/abcinx/xxx/refs/heads/main/Loon/Scripts/YouTube_remove_ads_response.js, requires-body=true, binary-body-mode=true, argument=[{blockUpload},{blockShorts},{blockImmersive},{captionLang},{debug}], tag=YouTube&YouTubeMusic

http-request ^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.* script-path=https://raw.githubusercontent.com/abcinx/xxx/refs/heads/main/Loon/Scripts/YouTube_remove_ads_request.js, requires-body=true, binary-body-mode=true, argument=[{captionLang}], tag=请求初始化

http-request ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event script-path=https://raw.githubusercontent.com/abcinx/xxx/refs/heads/main/Loon/Scripts/YouTube_remove_ads_request.js, requires-body=true, binary-body-mode=true, argument=[{blockUpload},{blockShorts},{blockImmersive},{captionLang},{debug}], tag=请求日志事件

[MitM]
hostname=*.googlevideo.com, youtubei.googleapis.com
