#!name=YouTube
#!desc=去除广告！
#!icon=https://raw.githubusercontent.com/abcinx/xxx/refs/heads/main/Icons/YouTube.PNG
#!date=2026-07-20

[Argument]
blockUpload=switch,"true","false",tag=+, desc=屏蔽上传按钮
blockImmersive=switch,"true","false",tag=选段, desc=屏蔽选段按钮
blockShorts=switch,"false","true",tag=Shorts, desc=屏蔽Shorts按钮
captionLang=select,"off","zh-Hans","zh-Hant","ja","ko","en",tag=字幕翻译, desc=字幕翻译语言
debug=switch,"false","true",tag=调试模式, desc=启用调试模式

[Script]
http-response ^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$ script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js, requires-body=true, binary-body-mode=true, argument=[{blockUpload},{blockShorts},{blockImmersive},{captionLang},{debug}], tag=youtube.response
http-request ^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.* script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js, requires-body=true, binary-body-mode=true, argument=[{captionLang}], tag=youtube.request.init

http-request ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js, requires-body=true, binary-body-mode=true, argument=[{blockUpload},{blockShorts},{blockImmersive},{captionLang},{debug}], tag=youtube.request.log_event

[MITM]
hostname = *.googlevideo.com, youtubei.googleapis.com
