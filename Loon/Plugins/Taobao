#====================
# Rewrite
#====================


# 开屏广告

^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv reject-dict


# 开屏资源

^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.etao\.noah\.query.*tao_splash reject-dict



# 淘宝启动页

^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get reject-dict



# 首页运营位

^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.newface\.awesome\.get reject-dict



# 二楼活动

^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.volvo\.secondfloor\.getconfig reject-dict



# 弹窗活动

^https:\/\/poplayer\.template\.alibaba\.com\/.* reject-dict



# 飞猪广告资源

^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\..* reject-dict



#====================
# 推荐流过滤
#====================


# 猜你喜欢

^https:\/\/.*\.taobao\.com\/.*guess.* reject-dict


# 推荐商品

^https:\/\/.*\.taobao\.com\/.*recommend.* reject-dict


# 信息流

^https:\/\/.*\.taobao\.com\/.*feed.* reject-dict



#====================
# Script
#====================


# 首页JSON净化

http-response

^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.*

