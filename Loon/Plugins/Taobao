#!name=淘宝净化
#!desc=淘宝净化插件：去除部分广告、营销推荐、视频流请求，保留基础购物功能。
#!icon=https://raw.githubusercontent.com/abcinx/xxx/refs/heads/main/IconSet/Adblock.png
#!date=2026-07-19

[Rule]

# ===== 淘宝广告/营销 =====
DOMAIN,et.tanx.com,REJECT
DOMAIN,df.tanx.com,REJECT
DOMAIN,opehs.tanx.com,REJECT
DOMAIN,adash.man.aliyuncs.com,REJECT
DOMAIN,beacon-api.aliyuncs.com,REJECT
DOMAIN,applog.uc.cn,REJECT
DOMAIN,atoken.m.taobao.com,REJECT
DOMAIN,retcode.alicdn.com,REJECT
DOMAIN,arms-retcode.aliyuncs.com,REJECT

DOMAIN,baichuan-sdk.alicdn.com,REJECT
DOMAIN,acs4baichuan.m.taobao.com,REJECT
DOMAIN,nbsdk-baichuan.alicdn.com,REJECT


# ===== 淘宝视频/逛逛 =====
DOMAIN-SUFFIX,video.taobao.com,REJECT
DOMAIN-SUFFIX,cloud.video.taobao.com,REJECT
DOMAIN-SUFFIX,media.taobao.com,REJECT
DOMAIN-SUFFIX,video.alibaba.com,REJECT


# ===== 淘宝推荐追踪 =====
DOMAIN-SUFFIX,ut.taobao.com,REJECT
DOMAIN-SUFFIX,umeng.com,REJECT
DOMAIN-SUFFIX,umtrack.com,REJECT


# ===== 淘宝营销接口 =====
URL-REGEX,^https:\/\/.*\/amdc\/mobileDispatch,REJECT

URL-REGEX,^https:\/\/.*\/recommend.*(item|feed|guess),REJECT

URL-REGEX,^https:\/\/.*\/mtop.*(guess|recommend|ad),REJECT


# ===== 关键词拦截 =====
DOMAIN-KEYWORD,tanx,REJECT
DOMAIN-KEYWORD,adash,REJECT
DOMAIN-KEYWORD,recommend,REJECT


[Rewrite]

# 淘宝广告请求
^https:\/\/.*\/amdc\/mobileDispatch reject

# 淘宝营销图片/推广资源
^https:\/\/.*alicdn.*\/.*ad.* reject


[MitM]

hostname=*.taobao.com,*.tmall.com,*.alicdn.com
