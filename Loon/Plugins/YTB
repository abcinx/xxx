#!name=YouTube&YouTube Music
#!desc=去除广告！
#!date=2026-07-19

[Rule]
# 阻止 QUIC，确保相关流量经过 HTTPS MITM
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[URL Rewrite]
# 移除视频地址中的 ctier=L 参数
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) 302 $1$2$3

# 拦截带有 oad 参数的广告视频请求
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad reject-200

# YouTube 广告统计
^https?:\/\/(www|s|m)\.youtube\.com\/api\/stats\/ads reject-200

# 广告投放及追踪
^https?:\/\/(www|s|m)\.youtube\.com\/(pagead|ptracking) reject-200

# 广告 QoE 统计
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?.*adcontext reject-200

# 广告可视性统计
^https?:\/\/(www|s)\.youtube\.com\/pcs\/activeview reject-200

[Script]
# Googlevideo 请求体处理
http-response ^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$ script-path=https://raw.githubusercontent.com/abcinx/xxx/refs/heads/main/Loon/Scripts/youtube.response.js, requires-body=true, binary-body-mode=true, tag=youtube.response

[MITM]
hostname = *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, m.youtube.com, s.youtube.com
