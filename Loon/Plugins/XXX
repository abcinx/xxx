
#!name=YouTube
#!desc=YouTube视频广告过滤及广告跟踪拦截，保留原生界面、Shorts、上传及正常播放
#!icon=https://raw.githubusercontent.com/abcinx/xxx/refs/heads/main/Icons/YouTube.PNG
#!date=2026-11-13

[Rule]
# 阻止 QUIC，确保相关流量经过 HTTPS MITM
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[URL Rewrite]
# 移除视频地址 ctier=L 参数
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) 302 $1$2$3

# 拦截带有广告标记的非正常视频请求
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad reject-200

# 拦截广告统计
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads reject-200

# 拦截广告投放及追踪
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) reject-200

# 拦截广告 QoE 统计
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext reject-200

[Script]
# Maasea Googlevideo 请求体处理
http-request ^https:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.* script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60, tag=YouTube请求处理, argument="{\"captionLang\":\"off\"}"

# Maasea YouTube log_event 请求处理
http-request ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60, tag=YouTube日志处理

# Maasea YouTube 响应体广告过滤
http-response ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(\?.*)?$ script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60, tag=YouTube响应体过滤, argument="{\"captionLang\":\"off\",\"blockUpload\":false,\"blockImmersive\":false,\"blockShorts\":false,\"debug\":false}"

[MITM]
hostname = -redirector*.googlevideo.com, *.googlevideo.com, www.youtube.com, s.youtube.com, youtubei.googleapis.com
