#!name=Spotify Enhanced
#!desc=Spotify 去广告增强版
#!icon=https://raw.githubusercontent.com/abcinx/xxx/refs/heads/main/Icons/Spotify.PNG
#!date=2026-07-21

[Rule]
# 禁止 QUIC 绕过 MITM
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,QUIC)),REJECT
# 广告统计
DOMAIN,aet.spotify.com,REJECT
# 广告相关
DOMAIN,adstudio.spotify.com,REJECT
DOMAIN,ads-fa.spotify.com,REJECT
DOMAIN,spclient.wg.spotify.com,REJECT-NO-DROP

[Rewrite]
# 广告配置
^https:\/\/(.*-)?spclient\.spotify\.com\/pendragon.* - reject
# PAM 推荐广告
^https:\/\/(.*-)?spclient\.spotify\.com\/pam-view-service\/.* - reject
# 推荐实验
^https:\/\/(.*-)?spclient\.spotify\.com\/(recommendations|inspired).* - reject
# 去除推荐歌单注入
^https:\/\/.*37i9dQZF.* - reject
# 禁止缓存配置
^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)\/user-customization-service\/v1\/customize$
header-del if-none-match

[Script]
# 搜索优化
http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)\/browsita\/v.\/browse
script-path=https://raw.githubusercontent.com/uki0xc/ukix/refs/heads/main/js/Spotify-search.js
requires-body=true
binary-body-mode=true
tag=spotify-search
# 首页滚动优化
http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)\/scrollsita\/v.\/scroll\/spotify
script-path=https://raw.githubusercontent.com/uki0xc/ukix/refs/heads/main/js/Spotify-scroll.js
requires-body=true
binary-body-mode=true
tag=spotify-scroll
# Gabo 广告事件
http-request ^https:\/\/(.*-spclient\.spotify\.com|spclient\.wg\.spotify\.com)\/gabo-receiver-service
script-path=https://raw.githubusercontent.com/uki0xc/ukix/refs/heads/main/js/Spotify-gabo.js
tag=spotify-gabo
# Bootstrap / 用户配置
http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)
script-path=https://raw.githubusercontent.com/uki0xc/ukix/refs/heads/main/js/Spotify-proto.js
requires-body=true
binary-body-mode=true
tag=spotify-proto

[MITM]
hostname = spclient.wg.spotify.com,*.spclient.spotify.com
