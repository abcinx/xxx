#!name=X网页净化
#!desc=X(Twitter)网页版广告与追踪拦截
#!icon=https://abs.twimg.com/icons/apple-touch-icon-192x192.png
#!date=2026-07-19


[Rule]

# ===== X广告服务器 =====
DOMAIN-SUFFIX,ads-twitter.com,REJECT
DOMAIN-SUFFIX,ads-api.twitter.com,REJECT
DOMAIN-SUFFIX,analytics.twitter.com,REJECT
DOMAIN-SUFFIX,syndication.twitter.com,REJECT

# ===== X统计追踪 =====
DOMAIN-SUFFIX,analytics.x.com,REJECT
DOMAIN-SUFFIX,api-analytics.twitter.com,REJECT
DOMAIN-SUFFIX,static.ads-twitter.com,REJECT

# ===== X推广内容 =====
DOMAIN-SUFFIX,pbs.twimg.com,REJECT
DOMAIN-SUFFIX,ton.twimg.com,REJECT

# ===== 第三方广告 =====
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT

# ===== Meta/广告联盟 =====
DOMAIN-SUFFIX,facebook.net,REJECT
DOMAIN-SUFFIX,adsrvr.org,REJECT
DOMAIN-SUFFIX,adnxs.com,REJECT


# ===== X API广告关键词 =====
DOMAIN-KEYWORD,advert,REJECT
DOMAIN-KEYWORD,promoted,REJECT
DOMAIN-KEYWORD,sponsor,REJECT


[Rewrite]

# 隐藏部分广告请求
^https:\/\/api\.x\.com\/.*\/promoted.* reject

^https:\/\/twitter\.com\/i\/ads.* reject


[MitM]

hostname=
api.x.com,
x.com,
twitter.com,
*.twitter.com
