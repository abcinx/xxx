[Argument]
tab=switch, false, true, tag=移除底栏创建按钮, desc=此开关控制是否移除底栏创建按钮
useractivity=switch, true, false, tag=启用Apple设备接力, desc=此开关控制是否使用Apple设备接力

[Rule]
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,QUIC)),REJECT
DOMAIN,aet.spotify.com,REJECT

[Rewrite]
^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/pendragon - reject
^https:\/\/.*-spclient\.spotify\.com(:443)?\/pam-view-service\/ - reject
^https:\/\/.*37i9dQZF1EYkqdzj48dyYq - reject
^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$ header-del if-none-match

[Script]
http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/browsita\/v.\/browse script-path=https://raw.githubusercontent.com/uki0xc/ukix/refs/heads/main/js/Spotify-search.js, requires-body=true, binary-body-mode=true, tag=spotify-search

http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/scrollsita\/v.\/scroll\/spotify script-path=https://raw.githubusercontent.com/uki0xc/ukix/refs/heads/main/js/Spotify-scroll.js, requires-body=true, binary-body-mode=true, tag=spotify-scroll

http-request ^https:\/\/(.*-spclient\.spotify\.com(:443)?|spclient\.wg\.spotify\.com)\/gabo-receiver-service script-path=https://raw.githubusercontent.com/uki0xc/ukix/refs/heads/main/js/Spotify-gabo.js, tag=spotify-gabo

http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$ script-path=https://raw.githubusercontent.com/uki0xc/ukix/refs/heads/main/js/Spotify-proto.js, requires-body=true, binary-body-mode=true,argument=[{tab},{useractivity}], tag=spotify-proto

[MITM]
hostname = spclient.wg.spotify.com, *spclient.spotify.com
